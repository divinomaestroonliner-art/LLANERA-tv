rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - email: string (required)
    //   - subscriptionActive: boolean (required)
    //   - subscriptionExpiry: string (optional)
    //   - planType: string (optional)
    //
    // Collection: users/{userId}/progress
    // Document ID: {contentId}
    // Fields:
    //   - userId: string (required)
    //   - contentId: string (required)
    //   - seconds: number (required)
    //   - updatedAt: string (required)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'subscriptionActive']) &&
             data.email is string &&
             data.subscriptionActive is bool &&
             (!('planType' in data) || data.planType in ['none', 'monthly', 'yearly']);
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'contentId', 'seconds', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.seconds is number &&
             data.seconds >= 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);

      match /progress/{contentId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidProgress(request.resource.data);
      }
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
